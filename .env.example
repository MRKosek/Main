# Copy to .env and fill in. .env is git-ignored. Never commit real keys.
# Never put passwords or 2FA codes anywhere in this project.

# Jev (TypeSafe AI): https://console.typesafe.ai
TYPESAFE_API_KEY=
TYPESAFE_DEFAULT_MODEL=jev-latest
# Pricing used for the cost-per-decision report. Check console.typesafe.ai for current rates.
JEV_PRICE_INPUT_PER_M=0.042
JEV_PRICE_OUTPUT_PER_M=0

# Alpaca. Use PAPER keys from https://app.alpaca.markets (Paper Trading > API Keys).
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_PAPER=true
# Live trading stays off unless this is exactly: I_ACCEPT_LIVE_RISK
# Don't set it until the final check in README.md passes.
LIVE_TRADING_ACK=

# Telegram alerts (create a bot with @BotFather; see deploy/DEPLOY.md)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Dashboard. Long random string, e.g. `python -c "import secrets;print(secrets.token_urlsafe(32))"`
DASHBOARD_TOKEN=
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8000

# Where state lives
BOT_DB_PATH=data/bot.sqlite3
